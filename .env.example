APP_ENV=development
CORS_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000
# Extra origin patterns, added to the defaults (e.g. ^https://sany\.dev$).
CORS_ORIGIN_REGEX=
# *.vercel.app deployments and any localhost port are always allowed unless
# this is false.
CORS_ALLOW_PREVIEWS=true

# Chat provider: "gemini" (Google Gemini API) or "openai_compatible"
# (Groq, OpenAI, OpenRouter, Together, ...). No local model providers.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60

# Gemini credentials. GEMINI_API_KEY is used for both the Gemini chat model
# and Gemini embeddings; GOOGLE_API_KEY works as an alias.
GEMINI_API_KEY=

# Embeddings use the hosted Gemini embedding model only.
# No local transformer models are downloaded or run.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION=portfolio_knowledge
KNOWLEDGE_DIR=./knowledge
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5
MAX_RETRIEVAL_ATTEMPTS=2
MIN_CONTEXT_CHARS=80

# Conversation memory (LangGraph SQLite checkpointer, one thread per session id).
CHECKPOINT_DB_PATH=./.memory/checkpoints.sqlite
MAX_HISTORY_TOKENS=2000

# Hosted platforms boot from a fresh filesystem. When true, the vector index is
# rebuilt at startup if it is missing, empty, or built with another embedding
# model. The index is also built during the Render build step.
ENSURE_INDEX_ON_STARTUP=true

# Per-client-IP limit for the paid chat routes. 0 disables it.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
# Set to false when clients can reach the app without a trusted reverse proxy.
TRUST_PROXY_HEADERS=true
